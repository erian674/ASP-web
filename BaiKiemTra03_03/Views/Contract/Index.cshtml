
@{
    ViewData["Title"] = "Index";
}
@model IEnumerable<Contract>
<div class="container">
    <table class="table">
        <thead>
            <tr>
                <th>Tên hợp đồng</th>
                <th>Ngày ký kết</th>
                <th>Giá trị</th>
                <th>Tên chức năng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td width="20%">@item.Contract_name</td>
                    <td width="20%">@String.Format("{0:dd/MM/yyyy}", item.Signing_Date)</td>
                    <td width="20%">@item.Contract_Value</td>
                    <td width="20%">@item.Customer.Customer_name</td>
                    <td width="20%">
                        <a asp-action="Upsert" asp-route-id="@item.CustomerId">Edit</a>|
                        <a href="#">Details</a>|
                        <a href="#" onclick="confirmDelete(@item.CustomerId, $(this))">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-controller="Contract" asp-action="Upsert" class="btn btn-primary">Thêm</a>
</div>
<script>
    function confirmDelete(Contract_Id, row) {
        if (confirm("Bạn có chắc chắn muốn xóa hợp đồng có id là" + Contract_Id + "?")) {
            xoa(Contract_Id, $(row))
        }
    }
    function xoa(Contract_Idx, row) {
        $.ajax({
            url: `Contract/Delete`,
            data: { Contract_Id: Contract_Idx },
            type: "POST",
            success: function(data){
                row.closest("tr").remove();
            }
        })
    }
</script>
@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}